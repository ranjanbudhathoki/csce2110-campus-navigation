//Q3 Visiting every building reachable from start and return to start
void showShortestRoundTrip(const string& startName) const {
    int start = findBuilding(startName);

    if (start == -1) {
        cout << "Building not found: " << startName << endl;
        return;
    }

    vector<int> distance, parent;
    bfs(start, distance, parent);

    //collecting all reachable buildings except the starting building
    vector<int> reachable;
    for (int i = 0; i < buildingNames.size(); i++) {
        if (distance[i] != -1 && i != start) {
            reachable.push_back(i);
        }
    }

    int count = reachable.size();

    vector<vector<int>> between(count, vector<int>(count));

    for (int i = 0; i < count; i++) {
        vector<int> legDistance;
        vector<int> legParent;

        bfs(reachable[i], legDistance, legParent);

        for (int j = 0; j < count; j++) {
            between[i][j] = legDistance[reachable[j]];
        }
    }

    if (count == 0) {
        cout << "Round Trip: " << startName << endl;
        cout << "Total connections: 0" << endl;
        return;
    }

    //using exact bitmask search for our small graph
    if (count > 20) {
        cout << "Too many reachable buildings for this exact method." << endl;
        return;
    }

    const int INF = 100000000;
    int numberOfSubsets = 1;

    for (int i = 0; i < count; i++) {
        numberOfSubsets = numberOfSubsets * 2;
    }

    vector<vector<int>> cost(numberOfSubsets, vector<int>(count, INF));
    vector<vector<int>> previous(numberOfSubsets, vector<int>(count, -1));

    //cost to travel from start to each possible first building
    for (int i = 0; i < count; i++) {
        cost[1 << i][i] = distance[reachable[i]];
    }

    // Try every order for visiting the reachable buildings.
    for (int subset = 1; subset < numberOfSubsets; subset++) {
        for (int last = 0; last < count; last++) {
            if (!(subset & (1 << last)) || cost[subset][last] == INF) {
                continue;
            }

            for (int next = 0; next < count; next++) {
                if (subset & (1 << next)) {
                    continue;
                }

                int newSubset = subset | (1 << next);
                int newCost = cost[subset][last] + between[last][next];

                if (newCost < cost[newSubset][next]) {
                    cost[newSubset][next] = newCost;
                    previous[newSubset][next] = last;
                }
            }
        }
    }

    // Add the trip back to the starting building.
    int allVisited = numberOfSubsets - 1;
    int lastBuilding = -1;
    int bestCost = INF;

    for (int last = 0; last < count; last++) {
        int totalCost = cost[allVisited][last] + distance[reachable[last]];

        if (totalCost < bestCost) {
            bestCost = totalCost;
            lastBuilding = last;
        }
    }

    // Reconstruct the order in which buildings are visited.
    vector<int> visitOrder;
    int subset = allVisited;
    int last = lastBuilding;

    while (last != -1) {
        visitOrder.push_back(reachable[last]);

        int earlier = previous[subset][last];
        subset = subset ^ (1 << last);
        last = earlier;
    }

    reverse(visitOrder.begin(), visitOrder.end());

    // Join shortest paths between the buildings in the chosen order.
    vector<int> route;
    route.push_back(start);
    int current = start;

    for (int next : visitOrder) {
        vector<int> segment = shortestPath(current, next);

        for (int i = 1; i < segment.size(); i++) {
            route.push_back(segment[i]);
        }

        current = next;
    }

    vector<int> returnPath = shortestPath(current, start);
    for (int i = 1; i < returnPath.size(); i++) {
        route.push_back(returnPath[i]);
    }

    cout << "Shortest round trip starting at " << startName << ":" << endl;
    for (int i = 0; i < route.size(); i++) {
        if (i > 0) {
            cout << " -> ";
        }
        cout << buildingNames[route[i]];
    }
    cout << endl;
    cout << "Total connections: " << bestCost << endl;
}


// Question 4: Find the different meeting building minimizing total connections
void showMeetingPoint(string nameA, string nameB, string nameC) const {
    int a = findBuilding(nameA);
    int b = findBuilding(nameB);
    int c = findBuilding(nameC);

    if (a == -1 || b == -1 || c == -1) {
        cout << "One or more starting buildings were not found." << endl;
        return;
    }

    vector<int> distanceA, parentA;
    vector<int> distanceB, parentB;
    vector<int> distanceC, parentC;

    bfs(a, distanceA, parentA);
    bfs(b, distanceB, parentB);
    bfs(c, distanceC, parentC);

    int meeting = -1;
    int bestTotal = 1000000000;

    for (int i = 0; i < buildingNames.size(); i++) {
        // The meeting building must be different from all three starts.
        if (i == a || i == b || i == c) {
            continue;
        }

        // All three students must be able to reach the candidate.
        if (distanceA[i] == -1 ||
            distanceB[i] == -1 ||
            distanceC[i] == -1) {
            continue;
        }

        int total = distanceA[i] + distanceB[i] + distanceC[i];

        if (total < bestTotal) {
            bestTotal = total;
            meeting = i;
        }
    }

    if (meeting == -1) {
        cout << "No meeting location is reachable by all three students."
            << endl;
        return;
    }

    cout << "Meeting location: " << buildingNames[meeting] << endl;
    cout << "Total connections: " << bestTotal << endl;

    // Print each route by following the BFS parent links backward.
    vector<int> routeA;
    for (int current = meeting; current != -1; current = parentA[current]) {
        routeA.push_back(current);
    }
    reverse(routeA.begin(), routeA.end());

    vector<int> routeB;
    for (int current = meeting; current != -1; current = parentB[current]) {
        routeB.push_back(current);
    }
    reverse(routeB.begin(), routeB.end());

    vector<int> routeC;
    for (int current = meeting; current != -1; current = parentC[current]) {
        routeC.push_back(current);
    }
    reverse(routeC.begin(), routeC.end());

    cout << nameA << "'s route: ";
    for (int i = 0; i < routeA.size(); i++) {
        if (i > 0) {
            cout << " -> ";
        }
        cout << buildingNames[routeA[i]];
    }
    cout << endl;

    cout << nameB << "'s route: ";
    for (int i = 0; i < routeB.size(); i++) {
        if (i > 0) {
            cout << " -> ";
        }
        cout << buildingNames[routeB[i]];
    }
    cout << endl;

    cout << nameC << "'s route: ";
    for (int i = 0; i < routeC.size(); i++) {
        if (i > 0) {
            cout << " -> ";
        }
        cout << buildingNames[routeC[i]];
    }
    cout << endl;
}

